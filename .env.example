# Kompletter JSON-Key des Google Service Accounts (als eine Zeile), siehe netlify/README.md
GOOGLE_SERVICE_ACCOUNT_JSON=

# Fine-grained GitHub PAT, nur für dieses Repo, Permission "Contents: Read and write"
GITHUB_TOKEN=

# Frei wählbares Team-Passwort, schützt die schreibenden Functions (create-post etc.)
CREATE_POST_SECRET=
